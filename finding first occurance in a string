class ABC {

    public static int str(String s1, String s2) {

        if (s2.isEmpty()) {
            return 0;
        }

        int n1 = s1.length();
        int n2 = s2.length();

        if (n2 > n1) {
            return -1;
        }

        for (int i = 0; i <= n1 - n2; i++) {

            if (s1.substring(i, i + n2).equals(s2)) {
                return i;
            }
        }

        return -1;
    }

    public static void main(String[] args) {
        System.out.println(str("abaabc", "abc"));
    }
}
