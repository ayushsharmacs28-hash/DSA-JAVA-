public class Main {
    public static void main(String[] args) {

        int[][] a = {
            {1, 1, 1},
            {1, 0, 1},
            {1, 1, 1}
        };

        int r = a.length;
        int c = a[0].length;
        int[][] ans = new int[r][c];

        for (int i = 0; i < r; i++) {
            for (int j = 0; j < c; j++) {

                int sum = 0, count = 0;

                for (int x = Math.max(0, i - 1);
                     x <= Math.min(r - 1, i + 1); x++) {

                    for (int y = Math.max(0, j - 1);
                         y <= Math.min(c - 1, j + 1); y++) {

                        sum += a[x][y];
                        count++;
                    }
                }

                ans[i][j] = sum / count;
            }
        }

        for (int[] row : ans) {
            for (int x : row)
                System.out.print(x + " ");
            System.out.println();
        }
    }
}
