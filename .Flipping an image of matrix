public class Main {
    public static void main(String[] args) {

        int[][] a = {
            {1, 0, 0},
            {0, 1, 0},
            {1, 1, 1}
        };

        for (int i = 0; i < a.length; i++) {
            int start = 0;
            int end = a[0].length - 1;

            while (start < end) {

                // Swap
                int temp = a[i][start];
                a[i][start] = a[i][end];
                a[i][end] = temp;

                start++;
                end--;
            }
        }

        // Print matrix
        for (int i = 0; i < a.length; i++) {
            for (int j = 0; j < a[0].length; j++) {
                System.out.print(a[i][j] + " ");
            }
            System.out.println();
        }
    }
}
