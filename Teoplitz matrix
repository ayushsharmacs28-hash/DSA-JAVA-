public class Main {
    public static void main(String[] args) {

        int[][] a = {
            {1, 2, 3, 4},
            {5, 1, 2, 3},
            {6, 5, 1, 2},
            {7, 6, 5, 1}
        };

        for (int i = 0; i < a.length - 1; i++) {
            for (int j = 0; j < a[0].length - 1; j++) {

                if (a[i][j] != a[i + 1][j + 1]) {
                    System.out.println("Not Toeplitz");
                    return;
                }
            }
        }

        System.out.println("Toeplitz");
    }
}
