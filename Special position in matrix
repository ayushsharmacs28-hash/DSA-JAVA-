public class Main {
    public static void main(String[] args) {

        int[][] a = {
            {1, 0, 0},
            {0, 0, 1},
            {0, 1, 0}
        };

        int count = 0;

        for (int i = 0; i < a.length; i++) {
            for (int j = 0; j < a[0].length; j++) {

                if (a[i][j] == 1) {

                    int rowSum = 0;
                    int colSum = 0;

                    // Row sum
                    for (int k = 0; k < a[0].length; k++)
                        rowSum += a[i][k];

                    // Column sum
                    for (int k = 0; k < a.length; k++)
                        colSum += a[k][j];

                    if (rowSum == 1 && colSum == 1)
                        count++;
                }
            }
        }

        System.out.println("Special Positions = " + count);
    }
}
